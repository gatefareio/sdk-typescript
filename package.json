{
  "name": "@gatefare/client",
  "version": "0.1.0",
  "description": "TypeScript client for the Gatefare x402 payment marketplace. Pay any Gatefare-listed API in USDC on Base with a few lines of code.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./langchain": {
      "types": "./dist/adapters/langchain.d.ts",
      "import": "./dist/adapters/langchain.js"
    },
    "./llamaindex": {
      "types": "./dist/adapters/llamaindex.d.ts",
      "import": "./dist/adapters/llamaindex.js"
    },
    "./openai-tools": {
      "types": "./dist/adapters/openai-tools.d.ts",
      "import": "./dist/adapters/openai-tools.js"
    },
    "./anthropic-tools": {
      "types": "./dist/adapters/anthropic-tools.d.ts",
      "import": "./dist/adapters/anthropic-tools.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "gatefare",
    "x402",
    "http-402",
    "usdc",
    "base",
    "agent",
    "ai-agent",
    "payment",
    "marketplace",
    "non-custodial"
  ],
  "homepage": "https://gatefare.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/gatefareio/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/gatefareio/sdk/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
